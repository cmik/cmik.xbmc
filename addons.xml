<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
    <addon id="plugin.video.gmatv" name="GMA.tv" version="1.0.2" provider-name="cmik">
        <requires>
            <import addon="xbmc.python" version="3.0.0"/>
            <import addon="script.module.six"/>
            <import addon="script.module.beautifulsoup4" version="4.9.3"/>
            <import addon="script.common.plugin.cache" version="2.6.1"/>
            <import addon="script.module.inputstreamhelper" version="0.4.2" />
            <import addon="script.module.requests" version="2.22.0"/>
            <import addon="script.module.unidecode" version="1.1.1"/>
            <import addon="plugin.video.youtube" version="6.8.18+matrix.1" />
        </requires>
        <extension point="xbmc.python.pluginsource" library="default.py">
            <provides>video</provides>
        </extension>
        <extension point="xbmc.service" library="service.py" start="startup"/>
        <extension point="xbmc.addon.metadata">
            <summary lang="en">GMA Pinoy TV</summary>
            <description lang="en">Enjoy full episodes of GMA Network shows for free! This is not an official GMA addon.</description>
            <disclaimer lang="en">No warranty here</disclaimer>
            <language>en</language>
            <platform>all</platform>
            <licence>GNU</licence>
            <forum></forum>
            <source>https://github.com/cmik/cmik.xbmc</source>
            <news>v1.0.2 (27/10/2024)
            [fix] Fixed search
            [change] Retrieve episodes from database if episodes list from site is not available
            </news>
            <assets>
                <icon>resources/icon.png</icon>
                <fanart>resources/fanart.jpg</fanart>
                <banner></banner>
                <clearlogo></clearlogo>
                <screenshot></screenshot>
            </assets>
        </extension>
    </addon>
    <addon id="plugin.video.tfctv" name="iWantTFC" version="3.7.0" provider-name="cmik">
        <requires>
            <import addon="xbmc.python" version="3.0.0"/>
            <import addon="script.module.six"/>
            <import addon="script.module.beautifulsoup4" version="4.9.3"/>
            <import addon="script.common.plugin.cache" version="2.6.1"/>
            <import addon="script.module.inputstreamhelper" version="0.2.2"/>
            <import addon="script.module.requests" version="2.22.0"/>
            <import addon="script.module.unidecode" version="1.1.1"/>
            <import addon="service.upnext" optional="true"/>
        </requires>
        <extension point="xbmc.python.pluginsource" library="default.py">
            <provides>video</provides>
        </extension>
        <extension point="xbmc.service" library="service.py"/>
        <extension point="xbmc.addon.metadata">
            <summary lang="en">TFC Pinoy TV</summary>
            <description lang="en">Enjoy TFC's Pinoy TV shows, movies, news and live channels! This is not an official TFC.tv addon. A subscription to TFC.tv website (http://tfc.tv) is required to enjoy TFC's catalog. iWantTFC Kodi uses Trakt but is not endorsed or certified by Trakt.</description>
            <disclaimer lang="en">No warranty here</disclaimer>
            <language>en</language>
            <platform>all</platform>
            <license>GNU</license>
            <website>https://addons.cmik.me/tfc-tv/</website>
            <forum>https://forum.kodi.tv/showthread.php?tid=317008</forum>
            <source>https://github.com/cmik/cmik.xbmc</source>
            <news>v3.7.0
              [fix] Live channels can be played again: the catalog is read for your country, as the website does (the channels of the Philippines were listed and refused elsewhere)
              [change] The settings use the Kodi 18+ format (same settings and values)
              [new] Location: the country, which decides the catalog and the live channels, is detected again at each start of Kodi (VPN, trip); this can be turned off and a country can be set by hand (Advanced > Location)
              [fix] The geo location service refused the request of the add-on (403), so the country was not detected on some devices

              v3.6.0
              [new] Up Next: the next episode is offered at the end of an episode (needs the Up Next add-on)
              [new] The catalog is looked at on a schedule: new shows are loaded and the new episodes of the shows of My List are announced
              [change] Video quality: choose how inputstream.adaptive selects the stream (its own settings, ask when playback starts, or in the player) and a maximum resolution; replaces the "Choose resolution" menu, which no longer worked
              [new] Trakt: what is watched can be scrobbled to your Trakt account (Connect to Trakt in the settings; episodes named SxEy and movies). iWantTFC Kodi uses Trakt but is not endorsed or certified by Trakt
            </news>
            <assets>
                <icon>resources/icon.png</icon>
                <fanart>resources/fanart.jpg</fanart>
            </assets>
        </extension>
    </addon>
    <addon id="repository.cmik.xbmc.addons" name="Cmik Repo" version="0.0.3" provider-name="cmik">
        <extension point="xbmc.addon.repository" name="Cmik Repo">
            <dir>
                <info compressed="false">https://github.com/cmik/cmik.xbmc/raw/master/addons.xml</info>
                <checksum>https://github.com/cmik/cmik.xbmc/raw/master/addons.xml.md5</checksum>
                <datadir zip="true">https://github.com/cmik/cmik.xbmc/raw/master/downloads</datadir>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en">Cmik's Repository</summary>
            <description lang="en">Find Cmik's add-ons here</description>
            <disclaimer lang="en">No warranty here</disclaimer>
            <language>en</language>
            <platform>all</platform>
            <licence>GNU</licence>
        </extension>
    </addon>
</addons>