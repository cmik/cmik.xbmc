<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
    <addon id="plugin.video.gmatv" name="GMA.tv" version="2.1.0" provider-name="cmik">
        <requires>
            <import addon="xbmc.python" version="3.0.0"/>
            <import addon="script.module.beautifulsoup4" version="4.9.3"/>
            <import addon="script.common.plugin.cache" version="2.6.1"/>
            <import addon="script.module.unidecode" version="1.1.1"/>
            <import addon="plugin.video.youtube" version="6.8.18+matrix.1" />
        </requires>
        <extension point="xbmc.python.pluginsource" library="default.py">
            <provides>video</provides>
        </extension>
        <extension point="xbmc.service" library="service.py"/>
        <extension point="xbmc.addon.metadata">
            <summary lang="en">GMA Pinoy TV</summary>
            <description lang="en">Enjoy full episodes of GMA Network shows for free! This is not an official GMA addon.</description>
            <disclaimer lang="en">No warranty here</disclaimer>
            <language>en</language>
            <platform>all</platform>
            <license>GPL-3.0-or-later</license>
            <forum></forum>
            <source>https://github.com/cmik/plugin.video.gmatv</source>
            <news>v2.1.0 (21/11/2026)
              [new] My List: add a show from its context menu, then My Shows and the last episode of each of them (kept when the catalog is reset)
              [change] The old Add to my watchlist entry of the episodes, which no longer worked, is removed
            </news>
            <assets>
                <icon>resources/icon.png</icon>
                <fanart>resources/fanart.jpg</fanart>
            </assets>
        </extension>
    </addon>
    <addon id="plugin.video.tfctv" name="iWantTFC" version="3.10.0" provider-name="cmik">
        <requires>
            <import addon="xbmc.python" version="3.0.0"/>
            <import addon="script.module.six"/>
            <import addon="script.module.beautifulsoup4" version="4.9.3"/>
            <import addon="script.common.plugin.cache" version="2.6.1"/>
            <import addon="script.module.inputstreamhelper" version="0.2.2"/>
            <import addon="script.module.requests" version="2.22.0"/>
            <import addon="script.module.unidecode" version="1.1.1"/>
            <import addon="service.upnext" optional="true"/>
        </requires>
        <extension point="xbmc.python.pluginsource" library="default.py">
            <provides>video</provides>
        </extension>
        <extension point="xbmc.service" library="service.py"/>
        <extension point="xbmc.addon.metadata">
            <summary lang="en">TFC Pinoy TV</summary>
            <description lang="en">Enjoy TFC's Pinoy TV shows, movies, news and live channels! This is not an official TFC.tv addon. A subscription to TFC.tv website (http://tfc.tv) is required to enjoy TFC's catalog. iWantTFC Kodi uses Trakt but is not endorsed or certified by Trakt.</description>
            <disclaimer lang="en">No warranty here</disclaimer>
            <language>en</language>
            <platform>all</platform>
            <license>GNU</license>
            <website>https://addons.cmik.me/tfc-tv/</website>
            <forum>https://forum.kodi.tv/showthread.php?tid=317008</forum>
            <source>https://github.com/cmik/cmik.xbmc</source>
            <news>v3.10.0
              [new] Skip Intro and Skip Recap: when iWant marks the intro or the recap of an episode, a button appears on the video (or the add-on skips it by itself, see the Playback settings)
              [change] Up Next offers the next episode when the credits start
              [change] Live TV is kept 5 minutes (an event can start any time), the menu of the website a few hours, Top Picks 30 minutes: faster menus

              v3.9.0
              [new] Live TV in the main menu: the live channels, then the live events, of your country
              [fix] The log no longer holds your tokens, cookies or passwords
              [fix] A title iWant refuses (GMA ones) stays in My List of Kodi only, with a message
              [fix] Actions started from a menu entry (Tools, login) end properly: no more error in the Kodi log
              [fix] An expired login is renewed for every call to the website: no more empty lists after a few days without signing in again
            </news>
            <assets>
                <icon>resources/icon.png</icon>
                <fanart>resources/fanart.jpg</fanart>
            </assets>
        </extension>
    </addon>
    <addon id="repository.cmik.xbmc.addons" name="Cmik Repo" version="0.0.3" provider-name="cmik">
        <extension point="xbmc.addon.repository" name="Cmik Repo">
            <dir>
                <info compressed="false">https://github.com/cmik/cmik.xbmc/raw/master/addons.xml</info>
                <checksum>https://github.com/cmik/cmik.xbmc/raw/master/addons.xml.md5</checksum>
                <datadir zip="true">https://github.com/cmik/cmik.xbmc/raw/master/downloads</datadir>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en">Cmik's Repository</summary>
            <description lang="en">Find Cmik's add-ons here</description>
            <disclaimer lang="en">No warranty here</disclaimer>
            <language>en</language>
            <platform>all</platform>
            <licence>GNU</licence>
        </extension>
    </addon>
</addons>